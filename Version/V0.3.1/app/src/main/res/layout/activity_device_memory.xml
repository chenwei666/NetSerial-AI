<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/device_memory_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="@string/device_memory_title" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText android:id="@+id/device_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/device_name_hint" android:maxLength="128" />
            <Spinner android:id="@+id/device_vendor" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/device_mode" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/device_baud" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/device_baud_hint" android:inputType="number" />
            <Button android:id="@+id/device_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_save" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:text="@string/memory_section" android:textStyle="bold" />
            <EditText android:id="@+id/memory_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/memory_hint" android:maxLength="1024" android:minLines="2" />
            <Button android:id="@+id/memory_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/memory_add" />
            <LinearLayout android:id="@+id/memory_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <Button android:id="@+id/data_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_export" />
            <Button android:id="@+id/data_import" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_import" />
            <TextView android:id="@+id/device_memory_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
