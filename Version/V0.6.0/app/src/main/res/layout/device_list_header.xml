<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/app_background" android:orientation="vertical" android:padding="16dp">
    <com.google.android.material.card.MaterialCardView style="@style/Widget.NetSerial.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorPrimaryContainer" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/dashboard_title" android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnPrimaryContainer" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/dashboard_subtitle" android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:id="@+id/dashboard_profile" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:textColor="?attr/colorOnPrimaryContainer" android:textStyle="bold" />
            <TextView android:id="@+id/dashboard_change_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp"
        android:text="@string/dashboard_quick_actions" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/app_on_surface" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_remote" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/remote_terminal_menu" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_ai" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ai_copilot_short" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_commands" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/command_library_short" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_network" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/network_tools_short" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_change" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/change_short" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_settings" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_settings_title" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_sessions" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sessions_menu" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_snapshots" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/snapshot_menu" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_operations" style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/operations_title" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
        android:text="@string/devices" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/app_on_surface" android:textStyle="bold" />
</LinearLayout>
