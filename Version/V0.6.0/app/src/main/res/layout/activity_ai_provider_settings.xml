<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/ai_settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="@string/ai_settings_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_settings_description"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/ai_profile_spinner"
                android:text="@string/ai_profile_label" />

            <Spinner
                android:id="@+id/ai_profile_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/ai_active_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ai_profile_not_active" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/ai_provider_spinner"
                android:text="@string/ai_provider_label" />

            <Spinner
                android:id="@+id/ai_provider_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <EditText
                android:id="@+id/ai_endpoint_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/ai_endpoint_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLength="2048"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ai_model_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ai_model_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="256"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ai_key_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ai_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLength="4096"
                android:saveEnabled="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ai_credential_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ai_key_not_saved" />

            <TextView
                android:id="@+id/ai_adapter_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_adapter_compatible" />

            <Button
                android:id="@+id/ai_save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ai_save_profile" />

            <Button
                android:id="@+id/ai_set_active_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_set_active" />

            <Button
                android:id="@+id/ai_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_test_connection" />

            <Button
                android:id="@+id/ai_delete_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_delete_profile" />

            <ProgressBar
                android:id="@+id/ai_test_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ai_operation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/ai_operation_ready"
                android:textIsSelectable="true" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
