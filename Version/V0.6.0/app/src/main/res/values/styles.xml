<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="AppTheme.Ocean" parent="AppTheme">
        <item name="colorPrimary">@color/theme_ocean_primary</item><item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_ocean_container</item><item name="colorOnPrimaryContainer">@color/theme_ocean_on_container</item>
        <item name="colorSecondary">@color/theme_ocean_secondary</item><item name="colorAccent">@color/theme_ocean_primary</item><item name="colorPrimaryDark">@color/theme_ocean_primary</item>
    </style>
    <style name="AppTheme.Emerald" parent="AppTheme">
        <item name="colorPrimary">@color/theme_emerald_primary</item><item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_emerald_container</item><item name="colorOnPrimaryContainer">@color/theme_emerald_on_container</item>
        <item name="colorSecondary">@color/theme_emerald_secondary</item><item name="colorAccent">@color/theme_emerald_primary</item><item name="colorPrimaryDark">@color/theme_emerald_primary</item>
    </style>
    <style name="AppTheme.Violet" parent="AppTheme">
        <item name="colorPrimary">@color/theme_violet_primary</item><item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_violet_container</item><item name="colorOnPrimaryContainer">@color/theme_violet_on_container</item>
        <item name="colorSecondary">@color/theme_violet_secondary</item><item name="colorAccent">@color/theme_violet_primary</item><item name="colorPrimaryDark">@color/theme_violet_primary</item>
    </style>
    <style name="AppTheme.Sunset" parent="AppTheme">
        <item name="colorPrimary">@color/theme_sunset_primary</item><item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_sunset_container</item><item name="colorOnPrimaryContainer">@color/theme_sunset_on_container</item>
        <item name="colorSecondary">@color/theme_sunset_secondary</item><item name="colorAccent">@color/theme_sunset_primary</item><item name="colorPrimaryDark">@color/theme_sunset_primary</item>
    </style>

    <style name="Widget.NetSerial.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item><item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item><item name="strokeColor">@color/app_outline</item>
        <item name="cardBackgroundColor">@color/app_surface_container</item>
    </style>
</resources>
