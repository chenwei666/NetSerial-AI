<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/app_settings_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_language_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settings_language"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_telnet_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_telnet_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_telnet_detail"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/settings_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_timeout_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_text_size_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settings_text_size"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_charset_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settings_charset"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/settings_keepalive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_keepalive_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <EditText
            android:id="@+id/settings_probe_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_probe_timeout_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_security_summary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_save" />

        <Button
            android:id="@+id/settings_forget_hosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_forget_hosts" />
    </LinearLayout>
</ScrollView>
