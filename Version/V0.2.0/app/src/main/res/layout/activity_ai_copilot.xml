<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_copilot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/ai_copilot_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="@string/ai_copilot_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_copilot_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ai_copilot_intent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ai_copilot_intent_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="4000"
                android:minLines="3" />

            <CheckBox
                android:id="@+id/ai_copilot_include_terminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_copilot_include_terminal" />

            <CheckBox
                android:id="@+id/ai_copilot_remember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_copilot_remember" />

            <Button
                android:id="@+id/ai_copilot_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_copilot_generate" />

            <ProgressBar
                android:id="@+id/ai_copilot_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ai_copilot_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />

            <LinearLayout
                android:id="@+id/ai_copilot_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
