<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_card"
    style="@style/Widget.NetSerial.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="82dp"
        android:orientation="horizontal"
        android:padding="16dp">
        <ImageView
            android:id="@+id/feature_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_feature_icon"
            android:contentDescription="@null"
            android:padding="8dp"
            app:tint="?attr/colorPrimary" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/feature_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/app_on_surface"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/feature_card_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="28sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
